{
  "name": "BookingEngineSetting",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "direct_bookings_enabled": {
      "type": "boolean",
      "default": true
    },
    "show_availability": {
      "type": "boolean",
      "default": true
    },
    "show_rates_publicly": {
      "type": "boolean",
      "default": true
    },
    "require_deposit": {
      "type": "boolean",
      "default": false
    },
    "deposit_percent": {
      "type": "number",
      "default": 20
    },
    "min_stay_default": {
      "type": "number",
      "default": 1
    },
    "allow_same_day_booking": {
      "type": "boolean",
      "default": true
    },
    "advance_booking_days": {
      "type": "number",
      "default": 365
    },
    "cancellation_hours": {
      "type": "number",
      "default": 48
    },
    "cancellation_policy": {
      "type": "string"
    }
  },
  "required": [
    "property_id"
  ]
}