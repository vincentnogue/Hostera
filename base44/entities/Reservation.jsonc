{
  "name": "Reservation",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "guest_id": {
      "type": "string"
    },
    "room_id": {
      "type": "string"
    },
    "room_type_id": {
      "type": "string"
    },
    "reservation_number": {
      "type": "string"
    },
    "check_in": {
      "type": "string",
      "format": "date"
    },
    "check_out": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "inquiry",
        "pending",
        "confirmed",
        "checked_in",
        "checked_out",
        "cancelled",
        "no_show",
        "waitlisted",
        "completed"
      ],
      "default": "confirmed"
    },
    "source": {
      "type": "string",
      "enum": [
        "direct",
        "walk_in",
        "ota",
        "phone",
        "corporate",
        "travel_agent",
        "group"
      ],
      "default": "direct"
    },
    "adults": {
      "type": "number",
      "default": 1
    },
    "children": {
      "type": "number",
      "default": 0
    },
    "total_amount": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "paid_amount": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "special_requests": {
      "type": "string"
    },
    "group_id": {
      "type": "string"
    }
  },
  "required": [
    "property_id",
    "guest_id",
    "check_in",
    "check_out"
  ]
}