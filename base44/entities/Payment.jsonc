{
  "name": "Payment",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "reservation_id": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string"
    },
    "guest_id": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "method": {
      "type": "string",
      "enum": [
        "cash",
        "card",
        "bank_transfer",
        "online",
        "deposit"
      ],
      "default": "card"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "refunded",
        "partial"
      ],
      "default": "pending"
    },
    "payment_date": {
      "type": "string",
      "format": "date-time"
    },
    "reference": {
      "type": "string"
    }
  },
  "required": [
    "property_id",
    "amount"
  ]
}