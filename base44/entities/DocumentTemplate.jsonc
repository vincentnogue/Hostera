{
  "name": "DocumentTemplate",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "invoice",
        "confirmation",
        "registration_card",
        "welcome_letter",
        "receipt",
        "folio",
        "email"
      ],
      "default": "invoice"
    },
    "content": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "default": "en"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft",
        "archived"
      ],
      "default": "active"
    },
    "last_modified": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "type"
  ]
}