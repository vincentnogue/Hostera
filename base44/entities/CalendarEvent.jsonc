{
  "name": "CalendarEvent",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "event",
        "demand",
        "maintenance",
        "holiday"
      ],
      "default": "event"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "property_id",
    "title",
    "date"
  ]
}