{
  "name": "IntegrationSetting",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "tool_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "accounting",
        "payment",
        "hospitality",
        "communication",
        "analytics",
        "ai"
      ],
      "default": "hospitality"
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "error"
      ],
      "default": "disconnected"
    },
    "description": {
      "type": "string"
    },
    "last_sync": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tool_name",
    "property_id"
  ]
}