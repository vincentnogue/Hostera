{
  "name": "RateRule",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "room_type_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "rule_type": {
      "type": "string",
      "enum": [
        "discount",
        "surcharge",
        "dynamic_pricing"
      ],
      "default": "discount"
    },
    "value_percent": {
      "type": "number",
      "default": 0
    },
    "min_occupancy_percent": {
      "type": "number",
      "default": 0
    },
    "min_stay": {
      "type": "number",
      "default": 0
    },
    "applies_to": {
      "type": "string",
      "enum": [
        "all",
        "direct",
        "ota"
      ],
      "default": "all"
    },
    "priority": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "property_id"
  ]
}