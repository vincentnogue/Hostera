{
  "name": "ShiftLog",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "department": {
      "type": "string",
      "enum": [
        "front_desk",
        "housekeeping",
        "maintenance",
        "food_beverage",
        "security",
        "management"
      ],
      "default": "front_desk"
    },
    "shift_type": {
      "type": "string",
      "enum": [
        "morning",
        "afternoon",
        "night"
      ],
      "default": "morning"
    },
    "log_type": {
      "type": "string",
      "enum": [
        "handover",
        "task",
        "incident",
        "note"
      ],
      "default": "note"
    },
    "content": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved"
      ],
      "default": "open"
    }
  },
  "required": [
    "property_id",
    "staff_name",
    "content"
  ]
}