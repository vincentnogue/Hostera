{
  "name": "ChannelConnection",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "channel_name": {
      "type": "string"
    },
    "channel_type": {
      "type": "string",
      "enum": [
        "ota",
        "metasearch",
        "gds",
        "direct",
        "corporate"
      ],
      "default": "ota"
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "error",
        "syncing"
      ],
      "default": "disconnected"
    },
    "last_sync": {
      "type": "string",
      "format": "date-time"
    },
    "rooms_mapped": {
      "type": "number",
      "default": 0
    },
    "bookings_this_month": {
      "type": "number",
      "default": 0
    },
    "revenue_this_month": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "channel_name",
    "property_id"
  ]
}