{
  "name": "Organization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "legal_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "hotel_group",
        "independent",
        "chain",
        "management_company"
      ],
      "default": "independent"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "timezone": {
      "type": "string",
      "default": "UTC"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "trial",
        "suspended",
        "pending",
        "closed"
      ],
      "default": "active"
    },
    "plan": {
      "type": "string",
      "enum": [
        "starter",
        "professional",
        "business",
        "enterprise"
      ],
      "default": "starter"
    },
    "logo_url": {
      "type": "string"
    },
    "properties_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}