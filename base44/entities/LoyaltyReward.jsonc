{
  "name": "LoyaltyReward",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "points_cost": {
      "type": "number",
      "default": 100
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "discount",
        "upgrade",
        "amenity",
        "experience",
        "voucher"
      ],
      "default": "discount"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "property_id"
  ]
}