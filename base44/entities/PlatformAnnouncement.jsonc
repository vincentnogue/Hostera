{
  "name": "PlatformAnnouncement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "audience": {
      "type": "string",
      "enum": [
        "all",
        "enterprise",
        "business",
        "professional",
        "starter"
      ],
      "default": "all"
    },
    "language": {
      "type": "string",
      "default": "en"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ],
      "default": "normal"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "published",
        "expired"
      ],
      "default": "draft"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "content"
  ]
}