{
  "name": "SecurityAlert",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "informational",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "low"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "investigating",
        "resolved"
      ],
      "default": "new"
    },
    "details": {
      "type": "string"
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "acknowledged_by": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "severity"
  ]
}