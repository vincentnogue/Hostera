{
  "name": "Review",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "guest_id": {
      "type": "string"
    },
    "guest_name": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 5
    },
    "title": {
      "type": "string"
    },
    "comment": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "direct",
        "google",
        "booking",
        "tripadvisor",
        "expedia"
      ],
      "default": "direct"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "published",
        "responded"
      ],
      "default": "pending"
    },
    "response": {
      "type": "string"
    },
    "review_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "property_id",
    "rating"
  ]
}