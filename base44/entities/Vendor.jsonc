{
  "name": "Vendor",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "laundry",
        "food_beverage",
        "repair",
        "security",
        "it",
        "landscaping",
        "other"
      ],
      "default": "other"
    },
    "contact_person": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 4
    },
    "performance_notes": {
      "type": "string"
    }
  },
  "required": [
    "property_id",
    "name"
  ]
}