{
  "name": "Property",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "legal_name": {
      "type": "string"
    },
    "property_type": {
      "type": "string",
      "enum": [
        "hotel",
        "resort",
        "motel",
        "hostel",
        "bnb",
        "guest_house",
        "villa",
        "apartment",
        "serviced_apartment",
        "aparthotel",
        "lodge",
        "inn",
        "other"
      ],
      "default": "hotel"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "timezone": {
      "type": "string",
      "default": "UTC"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "checkin_time": {
      "type": "string",
      "default": "14:00"
    },
    "checkout_time": {
      "type": "string",
      "default": "11:00"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "suspended",
        "trial",
        "closed"
      ],
      "default": "active"
    },
    "rooms_count": {
      "type": "number",
      "default": 0
    },
    "star_rating": {
      "type": "number",
      "default": 3
    },
    "facilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "organization_id"
  ]
}