{
  "name": "CommercialCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "percentage_discount",
        "fixed_discount",
        "free_trial",
        "plan_discount",
        "limited_time"
      ],
      "default": "percentage_discount"
    },
    "value": {
      "type": "number",
      "default": 0
    },
    "usage_limit": {
      "type": "number",
      "default": 0
    },
    "times_used": {
      "type": "number",
      "default": 0
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "expired"
      ],
      "default": "active"
    },
    "revenue_generated": {
      "type": "number",
      "default": 0
    },
    "customers_acquired": {
      "type": "number",
      "default": 0
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "name",
    "type"
  ]
}