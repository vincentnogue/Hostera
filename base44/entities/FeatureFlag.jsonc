{
  "name": "FeatureFlag",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "enabled",
        "disabled",
        "beta"
      ],
      "default": "disabled"
    },
    "rollout_percent": {
      "type": "number",
      "default": 100
    },
    "scope": {
      "type": "string",
      "enum": [
        "global",
        "organization",
        "plan"
      ],
      "default": "global"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_by": {
      "type": "string"
    }
  },
  "required": [
    "key",
    "name"
  ]
}