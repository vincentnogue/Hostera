{
  "name": "MarketingCampaign",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "email",
        "promo",
        "sms"
      ],
      "default": "email"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "sent"
      ],
      "default": "draft"
    },
    "audience": {
      "type": "string",
      "enum": [
        "all_guests",
        "repeat_guests",
        "vip_guests",
        "prospects"
      ],
      "default": "all_guests"
    },
    "subject": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "recipients": {
      "type": "number",
      "default": 0
    },
    "open_rate": {
      "type": "number",
      "default": 0
    },
    "bookings_generated": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "property_id"
  ]
}