# Required for the app to reach Supabase. Get these from:
# Supabase Dashboard -> Project Settings -> API
#
# On Cloudflare Pages, set these under:
# Pages project -> Settings -> Environment variables (for both Production and Preview)
#
# VITE_SUPABASE_ANON_KEY is the public "anon" key — safe to expose client-side.
# NEVER put the "service_role" key here or anywhere in frontend code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
