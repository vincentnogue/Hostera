# Required for the app to reach the base44 backend. Without these, the build
# still succeeds but every API call fails at runtime (see the
# "[base44] Warning: VITE_BASE44_APP_ID is not set" message during `vite build`).
#
# On Cloudflare Pages, set these under:
# Pages project -> Settings -> Environment variables (for both Production and Preview)
VITE_BASE44_APP_ID=
VITE_BASE44_APP_BASE_URL=
VITE_BASE44_FUNCTIONS_VERSION=
